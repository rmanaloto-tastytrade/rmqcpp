{
  "version": 10,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Base configuration for a build of rmqcpp",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "1",
        "CMAKE_BUILD_TYPE": "Debug",
        "BDE_BUILD_TARGET_SAFE": true,
        "CMAKE_CXX_STANDARD": "17",
        "BDE_BUILD_TARGET_CPP17": "17",
        "CMAKE_INSTALL_LIBDIR": "lib64",
        "CMAKE_POLICY_DEFAULT_CMP0167": "NEW"
      }
    },
    {
      "name": "macos-arm64-vcpkg",
      "description": "VCPKG based configuration for building on arm-based MacOS",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "inherits": "base",
      "environment": {
        "VCPKG_ROOT": "$env{HOME}/dev/tmp/vcpkg"
      },
      "cacheVariables": {
        "VCPKG_INSTALL_OPTIONS": "--allow-unsupported",
        "BDE_BUILD_TARGET_CPP17": "20",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON"
      }
    },
    {
      "name": "macos-x64-vcpkg",
      "description": "VCPKG based configuration for building on x86_64-based MacOS",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "inherits": "base",
      "environment": {
        "VCPKG_ROOT": "$env{HOME}/dev/tmp/vcpkg"
      },
      "cacheVariables": {
        "VCPKG_INSTALL_OPTIONS": "--allow-unsupported",
        "BDE_BUILD_TARGET_CPP17": "20",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON"
      }
    },
    {
      "name": "macos-arm64-vcpkg-llvm-26",
      "description": "VCPKG config on arm macOS using Homebrew LLVM and C++26",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-out/macos-arm64-vcpkg-llvm-26",
      "installDir": "${sourceDir}/cmake-out/macos-arm64-vcpkg-llvm-26/install",
      "environment": {
        "VCPKG_ROOT": "$env{HOME}/dev/tmp/vcpkg",
        "VCPKG_BUILD_TYPE": "release",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlays",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/llvm-macos.cmake"
      },
      "cacheVariables": {
        "VCPKG_INSTALL_OPTIONS": "--allow-unsupported",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/llvm-macos.cmake",
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "BDE_BUILD_TARGET_CPP17": "26",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/llvm",
        "CMAKE_OSX_SYSROOT": "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
      }
    },
    {
      "name": "linux-x64-vcpkg",
      "description": "VCPKG based configuration for building on x86_64-based Linux",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "inherits": "base"
    },
    {
      "name": "cppdev_c090s4_gcc15_clang22",
      "description": "VCPKG configuration for the cppdev_c090s4_gcc15_clang22 remote (clang-22, Ninja)",
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "inherits": "base",
      "environment": {
        "VCPKG_ROOT": "$env{HOME}/dev/tmp/vcpkg",
        "PATH": "/usr/local/bin:$env{HOME}/dev/tmp/vcpkg:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_C_COMPILER": "/usr/bin/clang-22",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-22",
        "CMAKE_CXX_STANDARD": "26",
        "BDE_BUILD_TARGET_CPP17": "20",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -lc++abi",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -lc++abi",
        "CMAKE_PREFIX_PATH": "/usr/lib/llvm-22",
        "CMAKE_INCLUDE_PATH": "/usr/lib/llvm-22/include/c++/v1",
        "CMAKE_LIBRARY_PATH": "/usr/lib/llvm-22/lib;/usr/lib/x86_64-linux-gnu",
        "CMAKE_POLICY_DEFAULT_CMP0167": "NEW"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "cppdev_c090s4_gcc15_clang22"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64-vcpkg-llvm-26",
      "configurePreset": "macos-arm64-vcpkg-llvm-26",
      "configuration": "Debug",
      "cleanFirst": true
    }
  ]
}
