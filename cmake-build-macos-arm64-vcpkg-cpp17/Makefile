# Build rule for target.
rmqamqp_tests: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 rmqamqp_tests
.PHONY : rmqamqp_tests

# fast build rule for target.
rmqamqp_tests/fast:
	$(MAKE) $(MAKESILENT) -f src/tests/rmqamqp/CMakeFiles/rmqamqp_tests.dir/build.make src/tests/rmqamqp/CMakeFiles/rmqamqp_tests.dir/build
.PHONY : rmqamqp_tests/fast

