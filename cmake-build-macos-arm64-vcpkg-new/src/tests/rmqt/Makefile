	cd /Users/ray.manaloto@tastytrade.com/dev/github/bloomberg/rmqcpp/cmake-build-macos-arm64-vcpkg-new && $(MAKE) $(MAKESILENT) -f src/tests/rmqt/CMakeFiles/rmqt_tests.dir/build.make src/tests/rmqt/CMakeFiles/rmqt_tests.dir/rmqt_simpleendpoint.t.cpp.s
.PHONY : rmqt_simpleendpoint.t.cpp.s

