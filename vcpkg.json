{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "rmqcpp",
    "version": "1.0.0",
    "configuration": {
        "overlay-ports": [
            "vcpkg-overlays"
        ]
    },
    "dependencies": [
      "boost-asio",
      "boost-beast",
      "cli11",
      "openssl",
      "gtest",
      "bde",
      "zstd",
      "quill",
      "glaze",
      "fmt",
      {
        "name": "opentelemetry-cpp",
        "features": [ "otlp-http" ]
    }
  ]
}
